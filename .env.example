# Copy to .env for local secrets. Never commit .env.

# Flask session signing (any random string is fine for localhost demos)
FLASK_SECRET_KEY=change-me-for-local-demo

# Optional: override default port (default 5000)
# PORT=5000

# Track D — Photon SMS. Leave empty to stay in Demo Mode (no real SMS).
PHOTON_KEY=

# Public base URL for Photon webhooks. On localhost you need a tunnel, e.g.:
#   ngrok http 5000
# then set BASE_URL to the https URL ngrok prints.
BASE_URL=
