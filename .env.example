# Copy to .env for local secrets. Never commit .env.

# Flask session signing (any random string is fine for localhost demos)
FLASK_SECRET_KEY=change-me-for-local-demo

# Optional: override default port (default 5000)
# PORT=5000

# Track D — Photon bridge. Leave empty to stay in Demo Mode (no real SMS).
# Start the bridge separately: cd bridge && npm install && npm run start
BRIDGE_URL=http://127.0.0.1:8787
BRIDGE_TOKEN=

# Optional legacy stub (unused once BRIDGE_URL is set)
PHOTON_KEY=
BASE_URL=
