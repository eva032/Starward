# Spectrum credentials from https://app.photon.codes
PROJECT_ID=
PROJECT_SECRET=

# Shared secret with Flask (must match BRIDGE_TOKEN in the repo root .env)
BRIDGE_TOKEN=

# Flask webhook the bridge forwards inbound texts to
FLASK_WEBHOOK_URL=http://127.0.0.1:5000/webhook/photon

# Optional bridge listen port (default 8787)
# PORT=8787
